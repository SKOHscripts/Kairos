<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requise même pour le loopback (127.0.0.1) : Android compte toute socket
         réseau, locale comprise, dans cette permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Requise à l'exécution sur Android 13+ (API 33, targetSdk 35) pour afficher des
         notifications système ; la demande runtime se fait depuis le bouton d'opt-in
         existant (KairosNotificationBridge#requestPermission), jamais au démarrage. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Mises à jour (docs/spec/mises-a-jour.md) : remettre l'APK téléchargé à
         l'installeur système. Android demande en plus, une fois, d'autoriser
         Kairos à installer des applications (KairosNotificationBridge#installUpdate),
         et l'utilisateur confirme chaque installation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Kairos"
        android:enableOnBackInvokedCallback="true">
        <!-- Sert l'APK de mise à jour vérifié à l'installeur (URI content://,
             lecture seule, jamais exporté) : remplace FileProvider (AndroidX). -->
        <provider
            android:name=".UpdateApkProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
