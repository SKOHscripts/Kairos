# Kairos (Kotlin Multiplatform) : les sorties Gradle sont ignorées par kmp/.gitignore.

# Outils Python de kmp/tools/ (thème, icônes, fixtures, fiches)
__pycache__/
*.py[cod]
.venv/
venv/

# Bases SQLite locales
*.db
# Vraies bases Kairos 2 des tests de migration (kmp/tools/gen_legacy_db.py) : versionnées.
!kmp/desktopApp/src/jvmTest/resources/legacy/**/tasks.db
# Schémas SQLDelight de référence (verifyMigrations) : un par version, versionnés.
!kmp/data/src/commonMain/sqldelight/databases/*.db

# Éditeurs et systèmes
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# (`site/` est la page GitHub Pages de Kairos, versionnée.)
