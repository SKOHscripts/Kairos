-- Schéma de Kairos 3 (docs/spec/modele-donnees.md). Tables et colonnes de
-- Kairos 2 (app/tasks_models.py), moins les intégrations retirées.
-- Dates : TEXT ISO 8601 (« 2026-09-28 »), heures locales naïves : TEXT
-- (« 2026-09-28T09:30 »), instants : TEXT ISO UTC (« 2026-09-28T07:00:00Z »).
-- Références entre tables « molles » (sans FOREIGN KEY), comme en Kairos 2.

CREATE TABLE task (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL DEFAULT '',
    description TEXT NOT NULL DEFAULT '',
    priority INTEGER,
    deadline TEXT,
    project_tag TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'todo',
    estimated_minutes INTEGER,
    pinned_start TEXT,
    parent_id INTEGER,
    recurrence TEXT NOT NULL DEFAULT '',
    scheduled_date TEXT,
    recurrence_day_of_month INTEGER,
    recurrence_day_of_week INTEGER,
    recurrence_period TEXT NOT NULL DEFAULT '',
    task_type TEXT NOT NULL DEFAULT '',
    fibonacci_points INTEGER,
    manual_time_spent_minutes INTEGER,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    -- Espace Équipe (docs/spec/equipe.md). En fin de table : c'est l'ordre que
    -- donne ALTER TABLE ADD COLUMN (migration 1.sqm), et `insertTaskWithId` est
    -- positionnel, donc une base migrée et une base neuve doivent coïncider.
    space INTEGER NOT NULL DEFAULT 0,
    assignee_id INTEGER,
    -- Suivi d'équipe (jalon E3, docs/spec/equipe-backlog-suivi.md) : avancement déclaré (0-100),
    -- jour de début (date locale) et identité stable d'une tâche d'équipe. Toujours NULL pour une
    -- tâche Perso. Même ordre que 3.sqm.
    progress_percent INTEGER,
    started_on TEXT,
    team_uid TEXT
);
CREATE INDEX task_status ON task(status);
CREATE INDEX task_parent ON task(parent_id);
CREATE INDEX task_space ON task(space);
CREATE INDEX task_assignee ON task(assignee_id);
CREATE INDEX task_team_uid ON task(team_uid);

CREATE TABLE time_block (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL DEFAULT '',
    start TEXT NOT NULL,
    end TEXT NOT NULL,
    kind TEXT NOT NULL DEFAULT 'busy',
    recurrence TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL
);
CREATE INDEX time_block_start ON time_block(start);

CREATE TABLE task_dependency (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER NOT NULL,
    blocker_id INTEGER NOT NULL,
    created_at TEXT NOT NULL,
    UNIQUE (task_id, blocker_id)
);
CREATE INDEX task_dependency_task ON task_dependency(task_id);
CREATE INDEX task_dependency_blocker ON task_dependency(blocker_id);

CREATE TABLE work_session (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER NOT NULL,
    started_at TEXT NOT NULL,
    ended_at TEXT,
    created_at TEXT NOT NULL
);
CREATE INDEX work_session_task ON work_session(task_id);

CREATE TABLE note (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    body TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'open',
    converted_task_id INTEGER,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);
CREATE INDEX note_status ON note(status);

-- Membres de l'équipe (espace Équipe, docs/spec/equipe.md) : vide tant que l'espace n'a pas servi.
-- Référencés par task.assignee_id (sans FOREIGN KEY).
CREATE TABLE team_member (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    uid TEXT NOT NULL,
    name TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT '',
    availability_percent INTEGER NOT NULL DEFAULT 100,
    hours_per_day REAL NOT NULL,
    is_self INTEGER NOT NULL DEFAULT 0,
    archived INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

-- Absences des membres (jalon E2) : plages de dates incluses, début et fin au format ISO.
-- Référencent team_member.id (sans FOREIGN KEY).
CREATE TABLE member_absence (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    member_id INTEGER NOT NULL,
    start TEXT NOT NULL,
    end TEXT NOT NULL,
    label TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL
);
CREATE INDEX member_absence_member ON member_absence(member_id);

-- Journal des tâches d'équipe (jalon E3) : écrit par le dépôt dans la transaction de chaque
-- modification. task_title recopie le titre (une tâche supprimée garde ses événements) ;
-- member_id = assigné au moment de l'événement (NULL au backlog). Références sans FOREIGN KEY.
CREATE TABLE team_event (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER NOT NULL,
    task_title TEXT NOT NULL,
    member_id INTEGER,
    kind TEXT NOT NULL,
    from_value TEXT,
    to_value TEXT,
    source TEXT NOT NULL,
    at TEXT NOT NULL
);
CREATE INDEX team_event_task ON team_event(task_id);
CREATE INDEX team_event_member ON team_event(member_id);

-- Réglages : une seule ligne (id = 1), JSON de com.skohscripts.kairos.core.model.Settings.
CREATE TABLE settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    json TEXT NOT NULL
);

-- Tâches ---------------------------------------------------------------------

allTasks:
SELECT * FROM task ORDER BY id;

insertTask:
INSERT INTO task (title, description, priority, deadline, project_tag, status, estimated_minutes,
    pinned_start, parent_id, recurrence, scheduled_date, recurrence_day_of_month,
    recurrence_day_of_week, recurrence_period, task_type, fibonacci_points,
    manual_time_spent_minutes, created_at, updated_at, space, assignee_id, progress_percent, started_on, team_uid)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertTaskWithId:
INSERT INTO task VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

updateTask:
UPDATE task SET title = ?, description = ?, priority = ?, deadline = ?, project_tag = ?, status = ?,
    estimated_minutes = ?, pinned_start = ?, parent_id = ?, recurrence = ?, scheduled_date = ?,
    recurrence_day_of_month = ?, recurrence_day_of_week = ?, recurrence_period = ?, task_type = ?,
    fibonacci_points = ?, manual_time_spent_minutes = ?, updated_at = ?, space = ?, assignee_id = ?,
    progress_percent = ?, started_on = ?, team_uid = ?
WHERE id = ?;

deleteTask:
DELETE FROM task WHERE id = ?;

deleteAllTasks:
DELETE FROM task;

-- Créneaux ---------------------------------------------------------------------

allTimeBlocks:
SELECT * FROM time_block ORDER BY start, id;

insertTimeBlockWithId:
INSERT INTO time_block VALUES (?, ?, ?, ?, ?, ?, ?);

insertTimeBlock:
INSERT INTO time_block (title, start, end, kind, recurrence, created_at) VALUES (?, ?, ?, ?, ?, ?);

updateTimeBlock:
UPDATE time_block SET title = ?, start = ?, end = ?, kind = ?, recurrence = ? WHERE id = ?;

deleteTimeBlock:
DELETE FROM time_block WHERE id = ?;

deleteAllTimeBlocks:
DELETE FROM time_block;

-- Dépendances ------------------------------------------------------------------

allDependencies:
SELECT * FROM task_dependency ORDER BY id;

insertDependencyWithId:
INSERT INTO task_dependency VALUES (?, ?, ?, ?);

insertDependency:
INSERT INTO task_dependency (task_id, blocker_id, created_at) VALUES (?, ?, ?);

deleteDependency:
DELETE FROM task_dependency WHERE task_id = ? AND blocker_id = ?;

deleteDependenciesOf:
DELETE FROM task_dependency WHERE task_id = :taskId OR blocker_id = :taskId;

deleteAllDependencies:
DELETE FROM task_dependency;

-- Sessions ---------------------------------------------------------------------

allWorkSessions:
SELECT * FROM work_session ORDER BY id;

insertWorkSessionWithId:
INSERT INTO work_session VALUES (?, ?, ?, ?, ?);

closeOpenSessionsOf:
UPDATE work_session SET ended_at = ? WHERE task_id = ? AND ended_at IS NULL;

closeAllOpenSessions:
UPDATE work_session SET ended_at = ? WHERE ended_at IS NULL;

insertWorkSession:
INSERT INTO work_session (task_id, started_at, ended_at, created_at) VALUES (?, ?, NULL, ?);

deleteAllWorkSessions:
DELETE FROM work_session;

-- Notes ------------------------------------------------------------------------

allNotes:
SELECT * FROM note ORDER BY id;

insertNoteWithId:
INSERT INTO note VALUES (?, ?, ?, ?, ?, ?);

insertNote:
INSERT INTO note (body, status, converted_task_id, created_at, updated_at) VALUES (?, 'open', NULL, ?, ?);

updateNote:
UPDATE note SET body = ?, status = ?, converted_task_id = ?, updated_at = ? WHERE id = ?;

deleteNote:
DELETE FROM note WHERE id = ?;

deleteAllNotes:
DELETE FROM note;

-- Membres ----------------------------------------------------------------------

allTeamMembers:
SELECT * FROM team_member ORDER BY id;

insertTeamMemberWithId:
INSERT INTO team_member VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertTeamMember:
INSERT INTO team_member (uid, name, role, availability_percent, hours_per_day, is_self, archived, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, 0, ?, ?);

updateTeamMember:
UPDATE team_member SET name = ?, role = ?, availability_percent = ?, hours_per_day = ?, is_self = ?, updated_at = ?
WHERE id = ?;

clearSelfExcept:
UPDATE team_member SET is_self = 0, updated_at = ? WHERE is_self = 1 AND id <> ?;

-- Archiver retire aussi « C'est moi » (un membre archivé n'est plus « moi »).
setMemberArchived:
UPDATE team_member SET archived = :archived, is_self = CASE WHEN :archived = 1 THEN 0 ELSE is_self END, updated_at = :updatedAt WHERE id = :id;

deleteTeamMember:
DELETE FROM team_member WHERE id = ?;

deleteAllTeamMembers:
DELETE FROM team_member;

-- Absences ---------------------------------------------------------------------

allMemberAbsences:
SELECT * FROM member_absence ORDER BY id;

insertMemberAbsenceWithId:
INSERT INTO member_absence VALUES (?, ?, ?, ?, ?, ?);

insertMemberAbsence:
INSERT INTO member_absence (member_id, start, end, label, created_at) VALUES (?, ?, ?, ?, ?);

updateMemberAbsence:
UPDATE member_absence SET start = ?, end = ?, label = ? WHERE id = ?;

deleteMemberAbsence:
DELETE FROM member_absence WHERE id = ?;

deleteAbsencesOfMember:
DELETE FROM member_absence WHERE member_id = ?;

deleteAllMemberAbsences:
DELETE FROM member_absence;

-- Journal ----------------------------------------------------------------------

allTeamEvents:
SELECT * FROM team_event ORDER BY id;

insertTeamEventWithId:
INSERT INTO team_event VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertTeamEvent:
INSERT INTO team_event (task_id, task_title, member_id, kind, from_value, to_value, source, at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteAllTeamEvents:
DELETE FROM team_event;

-- Équipe : remises à zéro --------------------------------------------------------

unassignTasksOf:
UPDATE task SET assignee_id = NULL, started_on = NULL, updated_at = ? WHERE assignee_id = ? AND space = 1 AND status = 'todo';

unassignAllTasks:
UPDATE task SET assignee_id = NULL WHERE assignee_id IS NOT NULL;

deleteTeamTasks:
DELETE FROM task WHERE space = 1;

deleteDependenciesOfTeamTasks:
DELETE FROM task_dependency
WHERE task_id IN (SELECT id FROM task WHERE space = 1) OR blocker_id IN (SELECT id FROM task WHERE space = 1);

deleteSessionsOfTeamTasks:
DELETE FROM work_session WHERE task_id IN (SELECT id FROM task WHERE space = 1);

-- Réglages ---------------------------------------------------------------------

readSettings:
SELECT json FROM settings WHERE id = 1;

writeSettings:
INSERT OR REPLACE INTO settings (id, json) VALUES (1, ?);

deleteSettings:
DELETE FROM settings;
