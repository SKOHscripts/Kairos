    <string name="legacy_import_action">Importer une base Kairos 2.x</string>
    <string name="legacy_import_hint">Reprend le fichier tasks.db de Kairos 2 : tâches, créneaux, notes, sessions de chrono et réglages. Les créneaux TimeTree ne sont pas repris.</string>
    <string name="legacy_confirm_title">Importer la base Kairos 2 ?</string>
    <string name="legacy_confirm_body">%1$d tâche(s), %2$d note(s), %3$d session(s) de chrono et %4$d créneau(x) seront repris. Ils remplacent toutes les données actuelles ; une sauvegarde est faite juste avant.</string>
