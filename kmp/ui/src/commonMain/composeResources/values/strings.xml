    <string name="guide_points_title">Comment estimer les points ?</string>
    <string name="guide_points_intro">Taille relative (jamais des heures) : volume × complexité × incertitude (« est-ce que je sais comment faire ? »). Compare à tes propres tâches déjà faites : « plus grosse que celle-ci, plus petite que celle-là ». En quelques secondes ; dans le doute, arrondis au-dessus.</string>
    <string name="guide_points_outro">Distinct de la durée : les points nourrissent l’ordre (l’effort divise le score), la durée sert au placement dans la journée. Une tâche peut être courte mais tordue, ou longue mais mécanique.</string>
    <string name="guide_points_yours">chez toi ≈ %1$s (médiane sur %2$d tâche(s))</string>
    <string name="guide_points_yours_unreliable">chez toi ≈ %1$s (médiane sur %2$d tâche(s), peu fiable)</string>
    <string name="guide_points_example">ex. « %1$s »</string>
    <string name="guide_points_none">ex. %1$s (aucune de tes tâches terminées à ce palier pour l’instant)</string>
    <string name="points_1_meaning">expédié, sans réflexion</string>
    <string name="points_2_meaning">chemin connu</string>
    <string name="points_3_meaning">bien cadré, zéro inconnue</string>
    <string name="points_5_meaning">plusieurs étapes ou un peu d’inconnu</string>
    <string name="points_8_meaning">vraie complexité ou inconnues</string>
    <string name="points_13_meaning">trop gros pour une seule tâche : à découper</string>
    <string name="points_21_meaning">un projet plutôt qu’une tâche : à découper</string>
    <string name="points_1_example">valider une MR triviale</string>
    <string name="points_2_example">une petite revue de code</string>
    <string name="points_3_example">un développement bien cadré</string>
    <string name="points_5_example">une fonctionnalité en plusieurs étapes</string>
    <string name="points_8_example">un sujet qu’il faudra d’abord explorer</string>
    <string name="points_13_example">à découper en sous-tâches</string>
    <string name="points_21_example">à découper en sous-tâches</string>
    <string name="inbox_help_title">Comment qualifier ?</string>
    <string name="inbox_help_why">La capture ne pose qu’un titre, volontairement. Une tâche n’entre dans l’agenda ordonné qu’une fois clarifiée : priorité et points posés, ici même, en un clic chacun.</string>
    <string name="inbox_help_priority">Priorité : l’importance de la tâche. Le délai compte déjà à part, par l’échéance.</string>
    <string name="settings_intro">Tous les réglages de Kairos, enregistrés sur cet appareil. Un champ invalide est signalé sous le champ ; rien n’est enregistré tant qu’il en reste un.</string>
    <string name="settings_section_day">Journée de travail</string>
    <string name="settings_section_wsjf">Score de priorité (WSJF)</string>
    <string name="settings_section_wsjf_body">Score = valeur (priorité + urgence de la date) ÷ effort (points).</string>
    <string name="settings_section_dip">Creux de l’après-midi</string>
    <string name="settings_section_dip_body">Pendant le creux, les tâches complexes cèdent leur place aux tâches légères. L’urgence et les échéances priment toujours ; le score affiché ne change pas.</string>
    <string name="settings_section_guards">Garde-fous</string>
    <string name="settings_section_types">Types de tâches</string>
    <string name="settings_section_stats">Statistiques</string>
    <string name="settings_section_holidays">Jours fériés</string>
    <string name="settings_section_holidays_body">Utilisés pour les jours ouvrés : « Décaler », séries « le N du mois ».</string>
    <string name="setting_default_duration">Durée par défaut d’une tâche (min)</string>
    <string name="setting_default_duration_help">Attribuée à une tâche sans estimation pour la placer dans la journée (jamais enregistrée).</string>
    <string name="setting_meeting_buffer">Marge après un créneau occupé (min)</string>
    <string name="setting_meeting_buffer_help">Réunion de 13h à 14h, marge de 5 : la tâche suivante commence à 14h05.</string>
    <string name="setting_workday_start">Début de journée (heure, 0-23)</string>
    <string name="setting_workday_start_help">Heure à laquelle le planning commence.</string>
    <string name="setting_workday_end">Fin de journée (heure, 0-23)</string>
    <string name="setting_workday_end_help">Au-delà, la journée « déborde ».</string>
    <string name="setting_priority_base">Base de valeur par priorité</string>
    <string name="setting_priority_base_help">Valeur d’une priorité : base ^ (2 − priorité). 4 donne P0 = 16, P1 = 4, P2 = 1. Baisser adoucit l’écart, monter le durcit.</string>
    <string name="setting_urgency_horizon">Horizon d’urgence (jours)</string>
    <string name="setting_urgency_horizon_help">Nombre de jours avant l’échéance où l’urgence commence à monter.</string>
    <string name="setting_urgency_peak">Poids maximal de l’urgence</string>
    <string name="setting_urgency_peak_help">Ce qu’ajoute une échéance atteinte, dans la même unité que la valeur de la priorité.</string>
    <string name="setting_default_points">Points par défaut</string>
    <string name="setting_default_points_help">Effort d’une tâche sans points ni durée (diviseur du score).</string>
    <string name="setting_dip_enabled">Activer le creux de l’après-midi</string>
    <string name="setting_dip_start">Début du creux (heure)</string>
    <string name="setting_dip_trough">Creux le plus profond (heure)</string>
    <string name="setting_dip_end">Fin du creux (heure)</string>
    <string name="setting_dip_help">Décale ces heures selon ton rythme (lève-tôt ou couche-tard). Début ≤ creux le plus profond ≤ fin.</string>
    <string name="setting_dip_penalty">Force de la pénalité</string>
    <string name="setting_dip_penalty_help">1 double l’effort d’une tâche de 21 points au plus profond du creux ; 0 neutralise le creux.</string>
    <string name="setting_stale_overdue">Seuil « traîne » en retard (jours)</string>
    <string name="setting_stale_overdue_help">Jours après une échéance dépassée avant l’étiquette « traîne depuis N j » (0 = jamais).</string>
    <string name="setting_stale_untouched">Seuil « traîne » sans date (jours)</string>
    <string name="setting_stale_untouched_help">Jours sans modification d’une tâche sans date avant la même étiquette (0 = jamais).</string>
    <string name="setting_overload">Seuil de surcharge P0</string>
    <string name="setting_overload_help">Au-delà de ce nombre de P0 non bloquées, un bandeau prévient que la priorité ne distingue plus rien.</string>
    <string name="setting_task_types">Types proposés dans l’édition</string>
    <string name="setting_task_types_help">Séparés par des virgules. Une tâche garde son type même s’il disparaît de la liste.</string>
    <string name="setting_stats_window">Fenêtre des statistiques (semaines)</string>
    <string name="setting_stats_window_help">Période des indicateurs récents : débit, temps par type, délais.</string>
    <string name="setting_holidays_fr">Jours fériés français</string>
    <string name="setting_extra_holidays">Jours fériés supplémentaires</string>
    <string name="setting_extra_holidays_help">Dates au format AAAA-MM-JJ, séparées par des virgules (ponts, fermetures).</string>
