<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Maintenant », disposition standard (docs/spec/widgets-android.md) : la carte « Maintenant » de la vue Jour
     sur le conteneur primaire, ses badges, le chrono en direct, la tâche suivante et trois boutons. Couleurs, textes et
     visibilités posés par WidgetSync ; boutons : « Fait » en pilule pleine (« Confirmer ? » au
     premier toucher), chrono et capture en pastilles rondes, cibles de 48 dp ; seuls les vues que RemoteViews accepte dès l'API 26. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/now_badges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/now_inbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="32dp"
                android:paddingStart="8dp"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/now_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_now_name"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/now_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/now_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/now_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="4dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/now_done"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp">

                <ImageView
                    android:id="@+id/now_done_bg"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_pill" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/now_done_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_check" />

                    <TextView
                        android:id="@+id/now_done_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:paddingStart="6dp"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/now_timer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp">

                <ImageView
                    android:id="@+id/now_timer_bg"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_pill" />

                <ImageView
                    android:id="@+id/now_timer_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/now_add"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp">

                <ImageView
                    android:id="@+id/now_add_bg"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_pill" />

                <ImageView
                    android:id="@+id/now_add_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_add" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
