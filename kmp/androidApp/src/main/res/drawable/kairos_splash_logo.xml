<?xml version="1.0" encoding="utf-8"?>
<!-- Logo statique de démarrage : même dessin et même réduction que
     kairos_splash_icon_base.xml, secteur à sa position finale (80° depuis midi,
     comme le logo). Affiché par le fond de fenêtre de démarrage
     (kairos_launch_background.xml, toutes versions : c'est le seul splash
     avant l'API 31) et par l'écran de démarrage applicatif de MainActivity,
     tous deux dans une boîte de 288dp centrée : le logo reste exactement à la
     même place et à la même taille que dans le splash système (API 31+), sans
     saut ni rejeu de l'animation au passage de l'un à l'autre. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <!-- Réduit à 0.64 autour du centre : le splash système (API 31+) dessine
         l'icône dans une boîte de 288dp et la rogne à un cercle de 192dp (les
         2/3 centraux, comme le premier plan d'une icône adaptative). Sans cette
         réduction, le disque (rayon 18.5 + trait 0.8 sur 20) débordait du masque
         et le logo apparaissait zoomé, cadre coupé. Rayon utile après réduction :
         12.35 sur 13.33 disponibles. Même groupe dans kairos_splash_logo.xml. -->
    <group
        android:pivotX="20"
        android:pivotY="20"
        android:scaleX="0.64"
        android:scaleY="0.64">
        <path
            android:fillColor="#FFEEDC"
            android:pathData="M1.5,20 A18.5,18.5 0 1 1 38.5,20 A18.5,18.5 0 1 1 1.5,20 Z" />
        <path
            android:strokeColor="#FFCC85"
            android:strokeWidth="1.6"
            android:fillColor="#00000000"
            android:pathData="M1.5,20 A18.5,18.5 0 1 1 38.5,20 A18.5,18.5 0 1 1 1.5,20 Z" />
        <path
            android:fillColor="#C28417"
            android:pathData="M20,20 L20,4 A16,16 0 0 1 35.76,17.22 Z" />
        <path
            android:fillColor="#2B251C"
            android:pathData="M17.4,20 A2.6,2.6 0 1 1 22.6,20 A2.6,2.6 0 1 1 17.4,20 Z" />
    </group>
</vector>
