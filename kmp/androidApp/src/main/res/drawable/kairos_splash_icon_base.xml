<?xml version="1.0" encoding="utf-8"?>
<!-- Icône du splash screen (API 31+, voir themes.xml) : même tracé que le logo
     Kairos (mire/cadran solaire — static/favicon.svg, templates/base.html,
     ic_launcher_foreground.xml), viewBox 40×40 identique pour réutiliser les
     mêmes coordonnées sans recalcul. Contrairement à ic_launcher_foreground.xml
     (juste le premier plan), ce drawable porte aussi son propre fond clair +
     anneau, mais le splash le rogne quand même à un cercle (voir le groupe
     réduit ci-dessous). Le secteur miel (`android:name="wedge"`)
     est la seule pièce animée (voir kairos_splash_icon.xml +
     animator/kairos_splash_wedge_sweep.xml) : les autres restent statiques. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <!-- Réduit à 0.64 autour du centre : le splash système (API 31+) dessine
         l'icône dans une boîte de 288dp et la rogne à un cercle de 192dp (les
         2/3 centraux, comme le premier plan d'une icône adaptative). Sans cette
         réduction, le disque (rayon 18.5 + trait 0.8 sur 20) débordait du masque
         et le logo apparaissait zoomé, cadre coupé. Rayon utile après réduction :
         12.35 sur 13.33 disponibles. Même groupe dans kairos_splash_logo.xml. -->
    <group
        android:pivotX="20"
        android:pivotY="20"
        android:scaleX="0.64"
        android:scaleY="0.64">
        <path
            android:fillColor="#FFEEDC"
            android:pathData="M1.5,20 A18.5,18.5 0 1 1 38.5,20 A18.5,18.5 0 1 1 1.5,20 Z" />
        <path
            android:strokeColor="#FFCC85"
            android:strokeWidth="1.6"
            android:fillColor="#00000000"
            android:pathData="M1.5,20 A18.5,18.5 0 1 1 38.5,20 A18.5,18.5 0 1 1 1.5,20 Z" />
        <path
            android:name="wedge"
            android:fillColor="#C28417"
            android:pathData="M20,20 L20,4 A16,16 0 0 1 20,4 Z" />
        <path
            android:fillColor="#2B251C"
            android:pathData="M17.4,20 A2.6,2.6 0 1 1 22.6,20 A2.6,2.6 0 1 1 17.4,20 Z" />
    </group>
</vector>
