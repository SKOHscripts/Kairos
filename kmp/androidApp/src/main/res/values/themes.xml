<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème de fenêtre (docs/spec/distribution.md § Android) : l'interface
         elle-même est dessinée par Compose (KairosTheme). Un seul thème clair :
         forceDarkAllowed=false refuse l'assombrissement automatique de certains
         constructeurs (décision reprise de Kairos 2). Avant l'API 31, la fenêtre
         de démarrage du système est windowBackground : fond de l'app + logo centré. -->
    <style name="Theme.Kairos" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/kairos_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
