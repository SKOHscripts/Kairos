<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème de fenêtre (docs/spec/distribution.md § Android) : l'interface
         elle-même est dessinée par Compose (KairosTheme). Thème clair ici, sombre dans values-night/ ;
         forceDarkAllowed=false refuse l'assombrissement automatique de certains
         constructeurs. Avant l'API 31, la fenêtre
         de démarrage du système est windowBackground : fond de l'app + cadran vide centré
         (relais de la page de démarrage, docs/spec/demarrage.md). -->
    <style name="Theme.Kairos" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/kairos_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- Cible de partage (docs/spec/partage-android.md) : fenêtre transparente, sans titre ni animation ; rien n'est
         visible le temps d'écrire la note. Parent explicite : rien du thème de l'application ne sert ici. -->
    <style name="Theme.Kairos.Share" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
