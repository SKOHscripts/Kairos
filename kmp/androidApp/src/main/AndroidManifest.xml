<?xml version="1.0" encoding="utf-8"?>
<!-- Permission réseau INTERNET (4.2.0, issue #139, docs/spec/connexions-en-ligne.md) : une seule, utilisée par les connexions
     de calendrier en ligne, désactivées par défaut et activées une par une dans les Réglages ; HttpPolicy impose le consentement
     et les règles de redirection. Un lien ICS seul ne demande aucune anti-fonctionnalité F-Droid (NonFreeNet viendra avec
     Microsoft ou Google). Avant la 4.2.0, aucune permission réseau (docs/spec/distribution.md § Android). ACCESS_NETWORK_STATE
     (4.2.0, décision du propriétaire du 2026-11-19) : permission normale, sans demande à l'utilisateur, exigée par JobScheduler
     pour la contrainte « réseau disponible » de la synchronisation en arrière-plan (cible API 34 et plus) ; elle ne donne aucun
     accès au réseau. Trois permissions pour le chrono
     (docs/spec/temps-reel-chrono.md § Android) : notifier (demandée à
     l'opt-in des alertes, jamais au démarrage) et remettre la notification et
     les alarmes après un redémarrage. Alarmes exactes des alertes du chrono
     (4.1.0, issue #219) : SCHEDULE_EXACT_ALARM, accordée d'office sur Android
     12 et 13, à accorder par l'utilisateur sur Android 14 et plus (sinon les
     alarmes restent inexactes) ; jamais USE_EXACT_ALARM. Une quatrième, facultative (3.10.0,
     docs/spec/connexions-externes.md § Android) : lire les calendriers du
     téléphone, demandée seulement quand l'utilisateur l'active ; ce n'est pas
     une permission réseau. Les widgets de l'écran d'accueil (3.12.0, docs/spec/widgets-android.md) n'en ajoutent
     aucune : deux fournisseurs, un récepteur d'actions privé et le service de la liste « Journée » (réservé au système
     par BIND_REMOTEVIEWS, un attribut et non une permission demandée). La cible de partage (4.6.0, docs/spec/partage-android.md) n'en
     ajoute aucune non plus. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".KairosApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kairos"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Partager vers Kairos (4.6.0, issue #293, docs/spec/partage-android.md) : un texte ou un lien partagé devient une note,
             sans ouvrir Kairos. Transparente, hors des récentes, sans historique ni affinité : elle ne touche pas à la tâche
             Kairos. Libellé et icône hérités de l'application. Aucune permission. -->
        <activity
            android:name=".ShareNoteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kairos.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Images partagées (4.6.0, docs/spec/notes-images.md § Partage d'images) : une ou plusieurs. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Photos des notes (4.6.0, docs/spec/notes-images.md § Android) : l'application photo du système écrit dans
             cache/camera/, partagé par ce fournisseur le temps de la prise de vue ; non exporté, aucune permission CAMERA. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.skohscripts.kairos.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".ChronoReceiver"
            android:exported="false" />
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".widgets.NowWidgetProvider"
            android:exported="true"
            android:label="@string/widget_now_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_info" />
        </receiver>
        <receiver
            android:name=".widgets.DayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_info" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetActionReceiver"
            android:exported="false" />
        <service
            android:name=".widgets.DayWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service
            android:name=".SyncJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
